# Local-only mirror of the secrets pushed to Cloudflare. Never commit a
# filled-in copy. Copy this to `.env` and fill in (or just run setup.sh /
# setup.py / setup.js — they generate `.env` for you).

# --- Required ---------------------------------------------------------
SITE_NAME=My Site
SITE_URL=https://example.com
ADMIN_TOKEN=replace-with-64-char-hex
INDEXNOW_KEY=replace-with-64-char-hex

# --- Optional CTA / aliases (override link defaults) ------------------
# SITE_CTA=Sign up to get started.
# SITE_SIGNUP_URL=/signup
# SITE_LOGIN_URL=/login
# SITE_PRICING_URL=/pricing
# SITE_CONTACT_URL=/contact

# --- AI providers (set as many as you like; each one is optional) -----
# Workers AI is the default (uses env.AI binding, no key needed).
# Configured providers are tried in registry order as a fallback chain.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...
# TOGETHER_API_KEY=...
# CEREBRAS_API_KEY=...

# --- Optional model overrides ----------------------------------------
# WORKERS_AI_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# WORKERS_AI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# OPENAI_TEXT_MODEL=gpt-5
# OPENAI_IMAGE_MODEL=gpt-image-1
# ANTHROPIC_TEXT_MODEL=claude-opus-4-7
# GEMINI_TEXT_MODEL=gemini-2.5-pro
# GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_TEXT_MODEL=deepseek-chat
# MISTRAL_TEXT_MODEL=mistral-large-latest
# TOGETHER_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# CEREBRAS_TEXT_MODEL=llama-3.3-70b
