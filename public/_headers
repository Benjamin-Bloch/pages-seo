# Serve installer scripts as plain text so `curl | bash`-style
# pipelines and browser preview both work. Cache short so updates
# propagate without a manual purge.
/install/run.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Cache-Control: public, max-age=300

/install/run.py
  Content-Type: text/x-python; charset=utf-8
  Cache-Control: public, max-age=300

/install/run.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=300

# Self-hosted webfonts used by the cover SVG renderer. Long-cache
# them aggressively — they're versioned implicitly by the URL (the
# weight is in the filename) and update only when the font itself
# is replaced (rare). cross-origin CORS so the SVG can reference
# them when embedded via <img>.
/_fonts/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ── Security headers ─────────────────────────────────────────────
# Static-asset responses get baseline hardening. (Function responses
# set their own headers in code — _headers doesn't apply to them.)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The admin SPA and sign-in page must never be framed (clickjacking)
# and should never be cached by shared caches.
/admin
  X-Frame-Options: DENY
  Cache-Control: no-store

/admin.html
  X-Frame-Options: DENY
  Cache-Control: no-store

/sign-in
  X-Frame-Options: DENY
  Cache-Control: no-store

/sign-in.html
  X-Frame-Options: DENY
  Cache-Control: no-store
