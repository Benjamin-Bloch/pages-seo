# Secrets — never commit a filled-in env.
.env
.env.*
!.env.example
.dev.vars

# Wrangler config holds resource IDs (D1 database_id, R2 bucket_name)
# that point at the maintainer's live account. The canonical "what
# this project expects" lives in wrangler.template.toml. Keep your
# real config local: copy the template to wrangler.toml after running
# the installer / setup.sh and it'll fill in your IDs.
wrangler.toml
wrangler.live.toml

# Setup script state machine. Generated locally; delete to start over.
.setup-state

# Local-only reference scratch files (e.g. soro-example.js used while
# building the embed widget; not part of the project).
soro-example.js

# Tool caches.
node_modules/
.wrangler/
__pycache__/

# Editor / OS noise.
.DS_Store
*.log
.idea/
.vscode/
